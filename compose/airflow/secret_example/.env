# Airflow Admin Credentials
AIRFLOW_ADMIN_USERNAME=user
AIRFLOW_ADMIN_PASSWORD=user
AIRFLOW_ADMIN_EMAIL=airflow@foxecast.com
AIRFLOW_ADMIN_FIRSTNAME=John
AIRFLOW_ADMIN_LASTNAME=Doe

# JWT Configuration for API Authentication
AIRFLOW__API_AUTH__JWT_SECRET=your_jwt_key
AIRFLOW__API_AUTH__JWT_ALGORITHM=HS256
AIRFLOW__API_AUTH__JWT_ISSUER=user
AIRFLOW__API_AUTH__JWT_LIFETIME_SECONDS=3600

# Secret keys
AIRFLOW__CORE__FERNET_KEY=your_fernet_key
AIRFLOW__API__SECRET_KEY=your_api_key

# Celery configs
AIRFLOW__CELERY__WORKER_API_URL: http://airflow-apiserver:8080
# Make sure that redis runs on port 6379, airflow-redis is the name of the container in compose
AIRFLOW__CELERY__BROKER_URL: redis://:@airflow-redis:6379/0
# URL structure: db+postgresql://{username}:{password}@{postgres-container-in-compose}/{database_name}
AIRFLOW__CELERY__RESULT_BACKEND: db+postgresql://airflow:airflow@airflow-postgres/airflow

# Connection to the PostgreSQL
# URL structure: postgresql+psycopg2://{username}:{password}@{postgres-container-in-compose}/{database_name}
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://airflow:airflow@airflow-postgres/airflow

# Airflow Environment Variables for ECMWF Downloader DAG
# (it should be muiltylined, but for now word wrap is used in env-files)
AIRFLOW_VAR_ECMWF_DOWNLOADER_CONFIG={"num_workers":3,"max_active_runs":1,"retries":2,"retry_delay_minutes":5,"bucket_name":"forecast-data","s3_prefix":"ifs","minio_endpoint":"http://minio:9100","rabbitmq_enabled":true,"rabbitmq_conn_id":"amqp://user:user@rabbitmq:5672/","rabbitmq_exchange":"forecast_exchange","rabbitmq_routing_key":"opensource_queue","rabbitmq_exchange_type":"direct","rabbitmq_delivery_mode":2,"rabbitmq_priority":0,"rabbitmq_content_type":"application/json","ecmwf_max_retries":3,"ecmwf_retry_delay":30,"ecmwf_timeout":60,"validate_file_size":true,"min_file_size_bytes":1024,"cleanup_temp_files":true}

# Secret connection IDs
# MinIO is set via endpoint_url with %3A instead of ':' and %2F instead of '/'
AIRFLOW_CONN_MINIO_CONN='aws://username:password@?endpoint_url=http%3A%2F%2Fminio%3A9000'
AIRFLOW_CONN_RABBITMQ_DEFAULT='amqp://username:password@rabbitmq:5672/'